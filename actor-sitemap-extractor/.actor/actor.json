{
  "actorSpecification": 1,
  "name": "sitemap-url-extractor",
  "title": "Sitemap URL Extractor (index, .gz, lastmod, status codes)",
  "description": "Get every URL from a website's XML sitemaps: auto-discovery via robots.txt, sitemap indexes, gzipped sitemaps, lastmod/changefreq/priority, images and hreflang, plus optional HTTP status check for each URL.",
  "version": "0.1",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "URLs",
          "transformation": {
            "fields": [
              "url",
              "lastmod",
              "changefreq",
              "priority",
              "status",
              "redirectTo",
              "sitemap"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      },
      "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL listed in the sitemap"
          },
          "lastmod": {
            "type": [
              "string",
              "null"
            ],
            "description": "<lastmod> value"
          },
          "changefreq": {
            "type": [
              "string",
              "null"
            ],
            "description": "<changefreq> value"
          },
          "priority": {
            "type": [
              "number",
              "null"
            ],
            "description": "<priority> value"
          },
          "images": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Number of <image:image> entries"
          },
          "alternates": {
            "type": [
              "array",
              "null"
            ],
            "description": "hreflang alternates: hreflang, href"
          },
          "sitemap": {
            "type": [
              "string",
              "null"
            ],
            "description": "Sitemap file the URL came from"
          },
          "status": {
            "type": [
              "integer",
              "string",
              "null"
            ],
            "description": "HTTP status (only with status check)"
          },
          "redirectTo": {
            "type": [
              "string",
              "null"
            ],
            "description": "Redirect target (only with status check)"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}